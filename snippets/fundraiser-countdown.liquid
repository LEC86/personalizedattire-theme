{%- comment -%}
  Small countdown badge showing days/hours until the fundraiser ends,
  positioned in the top-right corner of the product image gallery.

  Set the end date via the product metafield: custom.fundraiser_end_date
  (Admin > Products > this product > Metafields). If not set, the badge
  doesn't render at all.

  Usage: {% render 'fundraiser-countdown' %}
{%- endcomment -%}
{%- assign end_date = product.metafields.custom.fundraiser_end_date.value -%}

{%- if end_date != blank -%}
  <div
    class="fundraiser-countdown-badge"
    data-block="fundraiser-countdown"
    data-end-date="{{ end_date | date: '%Y-%m-%dT23:59:59' }}"
    hidden
  >
    <span class="fundraiser-countdown-text">Fundraiser Ends in: --</span>
  </div>

  <style>
    .fundraiser-countdown-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 5;
      background: #c0392b;
      color: #fff !important;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.3;
      padding: 9px 14px;
      border-radius: 6px;
      pointer-events: none;
      white-space: nowrap;
    }
    .fundraiser-countdown-text {
      color: #fff !important;
    }
  </style>

  <script>
    (function () {
      var badge = document.querySelector('[data-block="fundraiser-countdown"]');
      if (!badge || badge.dataset.dsInit) return;
      badge.dataset.dsInit = "true";

      function placeBadge() {
        var gallery = document.querySelector('media-gallery');
        if (!gallery) return false;
        var computedPosition = window.getComputedStyle(gallery).position;
        if (computedPosition === 'static') {
          gallery.style.position = 'relative';
        }
        badge.hidden = false;
        gallery.appendChild(badge);
        return true;
      }

      function updateCountdown() {
        var endDateStr = badge.getAttribute('data-end-date');
        var endDate = new Date(endDateStr);
        var now = new Date();
        var diffMs = endDate - now;
        var textEl = badge.querySelector('.fundraiser-countdown-text');

        if (diffMs <= 0) {
          textEl.textContent = 'Fundraiser Has Ended';
          return;
        }

        var totalHours = Math.floor(diffMs / (1000 * 60 * 60));
        var days = Math.floor(totalHours / 24);
        var hours = totalHours % 24;

        var parts = [];
        if (days > 0) parts.push(days + (days === 1 ? ' day' : ' days'));
        parts.push(hours + (hours === 1 ? ' hour' : ' hours'));

        textEl.textContent = 'Fundraiser Ends in: ' + parts.join(' ');
      }

      // Try placing immediately, and retry briefly in case the gallery
      // hasn't rendered yet on slower connections.
      var attempts = 0;
      var placeInterval = setInterval(function () {
        attempts++;
        var placed = placeBadge();
        if (placed || attempts > 20) {
          clearInterval(placeInterval);
          if (placed) {
            updateCountdown();
            setInterval(updateCountdown, 60000);
          }
        }
      }, 150);
    })();
  </script>
{%- endif -%}
