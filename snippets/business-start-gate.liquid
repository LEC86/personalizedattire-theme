{%- comment -%}
  Keeps the Shopify Business Shirt Request form hidden until the customer
  clicks a "Start My Shirts" button. The form lives in the apps section with
  template section key 17869544649a9a2a30. When the page loads, move that
  form section directly before the product description so the request form
  appears before the long description instead of at the bottom of the page.
  If the page is loaded with ?another_design=1, automatically reopen the form
  so customers can submit another shirt design after a completed submission.
{%- endcomment -%}

<div class="business-start-gate" data-business-start-gate>
  <p class="business-start-gate__message">Upload your design below. We’ll build your shirts and email you a link to purchase — no payment required now.</p>
  <button type="button" class="business-start-gate__button" data-business-start-button>
    Start My Shirts
  </button>
</div>

<style>
  .business-start-gate {
    margin: 18px 0 8px;
    text-align: center;
  }

  .business-start-gate__message {
    margin: 0 0 10px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
  }

  .business-start-gate__button {
    width: 100%;
    min-height: 52px;
    padding: 14px 22px;
    border: 2px solid #111;
    border-radius: 8px;
    background: #E3FC02;
    color: #111;
    font: inherit;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.14);
  }

  .business-start-gate__button:hover {
    background: #d3ea02;
  }

  html:not(.business-shirt-form-started) [id*="17869544649a9a2a30"] {
    display: none !important;
  }

  html.business-shirt-form-started .business-start-gate {
    display: none;
  }
</style>

<script>
(function () {
  if (window.businessStartGateInitialized) return;
  window.businessStartGateInitialized = true;

  var root = document.documentElement;

  function normalizeText(value) {
    return (value || '').replace(/\s+/g, ' ').trim().toLowerCase();
  }

  function getRequestFormSection() {
    return document.querySelector('[id*="17869544649a9a2a30"]');
  }

  function moveFormBeforeDescription() {
    var formSection = getRequestFormSection();
    var description = document.querySelector('.product__description');

    if (!formSection || !description || formSection.dataset.businessFormMoved === 'true') return;

    description.parentNode.insertBefore(formSection, description);
    formSection.dataset.businessFormMoved = 'true';
  }

  function showRequestForm(shouldScroll) {
    moveFormBeforeDescription();
    root.classList.add('business-shirt-form-started');

    if (shouldScroll) {
      window.setTimeout(function () {
        var formSection = getRequestFormSection();
        if (formSection) {
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 120);
    }
  }

  function startShirts(event) {
    if (event) event.preventDefault();
    showRequestForm(true);
  }

  function bindStartButtons() {
    document.querySelectorAll('button, a, [role="button"]').forEach(function (el) {
      if (el.dataset.businessStartBound === 'true') return;

      var isGateButton = el.hasAttribute('data-business-start-button');
      var isNamedButton = normalizeText(el.textContent) === 'start my shirts';

      if (isGateButton || isNamedButton) {
        el.dataset.businessStartBound = 'true';
        el.addEventListener('click', startShirts);
      }
    });
  }

  function initializeLayout() {
    moveFormBeforeDescription();
    bindStartButtons();
  }

  initializeLayout();

  var params = new URLSearchParams(window.location.search);
  if (params.get('another_design') === '1') {
    showRequestForm(true);
  }

  var observer = new MutationObserver(initializeLayout);
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
