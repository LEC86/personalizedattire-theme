{%- comment -%}
  Shows several separate Shopify products on one page, each with its
  own working variant picker and Add to Cart button. Which products
  show up is fully controlled by product-picker blocks in the theme
  customizer -- add, remove, or reorder blocks anytime without touching
  code.
{%- endcomment -%}

<div class="multi-product-section">
  {%- if section.settings.heading != blank -%}
    <h2 class="multi-product-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="multi-product-grid">
    {%- for block in section.blocks -%}
      {%- assign card_product = block.settings.product -%}
      {%- if card_product != blank -%}
        <div class="multi-product-card" {{ block.shopify_attributes }}>
          <a href="{{ card_product.url }}" class="multi-product-card-image-link">
            {%- if card_product.featured_image -%}
              <img
                src="{{ card_product.featured_image | image_url: width: 500 }}"
                alt="{{ card_product.title | escape }}"
                loading="lazy"
                class="multi-product-card-image"
              >
            {%- else -%}
              <div class="multi-product-card-image multi-product-card-image--placeholder"></div>
            {%- endif -%}
          </a>

          <div class="multi-product-card-body">
            <h3 class="multi-product-card-title">
              <a href="{{ card_product.url }}">{{ card_product.title }}</a>
            </h3>
            <p class="multi-product-card-price">{{ card_product.price | money }}</p>

            {%- form 'product', card_product, class: 'multi-product-card-form' -%}
              {%- unless card_product.has_only_default_variant -%}
                <select name="id" class="multi-product-card-variant-select">
                  {%- for variant in card_product.variants -%}
                    <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                      {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
              {%- else -%}
                <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
              {%- endunless -%}

              <button
                type="submit"
                class="multi-product-card-button"
                {% unless card_product.available %}disabled{% endunless %}
              >
                {%- if card_product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
              </button>
            {%- endform -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>
  .multi-product-section {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 40px 20px;
  }
  .multi-product-heading {
    text-align: center;
    margin: 0 0 28px;
    font-size: 26px !important;
    font-weight: 700 !important;
  }
  .multi-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }
  .multi-product-card {
    border: 1px solid #d9d9d9;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .multi-product-card-image-link {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
  }
  .multi-product-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .multi-product-card-image--placeholder {
    width: 100%;
    height: 100%;
    background: #eee;
  }
  .multi-product-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .multi-product-card-title {
    margin: 0;
    font-size: 15px !important;
    font-weight: 600 !important;
  }
  .multi-product-card-title a {
    color: inherit !important;
    text-decoration: none !important;
  }
  .multi-product-card-price {
    margin: 0;
    font-size: 14px !important;
    color: #444 !important;
    font-weight: 500 !important;
  }
  .multi-product-card-form {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .multi-product-card-variant-select {
    border: 1px solid #b5b5b5;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 13px;
    color: #1a1a1a;
    background: #fff;
  }
  .multi-product-card-button {
    background: #2684ff;
    color: #fff !important;
    border: none;
    border-radius: 999px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .multi-product-card-button:hover {
    background: #1c6fe0;
  }
  .multi-product-card-button:disabled {
    background: #ccc;
    cursor: not-allowed;
  }
</style>

{% schema %}
{
  "name": "Multi-Product Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop These Products"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Multi-Product Showcase",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
